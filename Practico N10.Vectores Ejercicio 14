#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    double vec[n];

    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (vec[i] > vec[j]) {
                double temp = vec[i];
                vec[i] = vec[j];
                vec[j] = temp;
            }
        }
    }

    cout << "Vector ordenado ascendentemente:" << endl;
    for (int i = 0; i < n; i++) {
        cout << vec[i] << " ";
    }
    cout << endl;

    return 0;
}
