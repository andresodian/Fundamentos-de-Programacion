#include <iostream>
#include <string>

using namespace std;

int main() {
    int n;
    string palabra, frase = "";

    cout << "Cuantas palabras va a ingresar: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        cin >> palabra;
        if (i != 0) {
            frase += " ";
        }
        frase += palabra;
    }

    cout << frase << endl;

    return 0;
}
