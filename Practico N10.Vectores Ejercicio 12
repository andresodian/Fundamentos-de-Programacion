#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    vector<double> vec(n);
    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    vector<double> vecUnico;

    for (int i = 0; i < n; i++) {
        bool duplicado = false;
        for (int j = 0; j < vecUnico.size(); j++) {
            if (vec[i] == vecUnico[j]) {
                duplicado = true;
                break;
            }
        }
        if (!duplicado) {
            vecUnico.push_back(vec[i]);
        }
    }

    cout << "Vector sin duplicados:" << endl;
    for (int i = 0; i < vecUnico.size(); i++) {
        cout << vecUnico[i] << " ";
    }
    cout << endl;

    return 0;
}

