#include <iostream>
#include <string>

using namespace std;

int main() {
    string texto;
    int palabras = 0;
    bool enPalabra = false;

    cout << "Ingrese un texto: ";
    getline(cin, texto);

    for (int i = 0; i < texto.length(); i++) {
        if (texto[i] != ' ' && !enPalabra) {
            enPalabra = true;
            palabras++;
        } else if (texto[i] == ' ') {
            enPalabra = false;
        }
    }

    cout << palabras << " palabras" << endl;

    return 0;
}
