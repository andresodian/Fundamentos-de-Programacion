#include <iostream>
#include <string>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de alumnos: ";
    cin >> n;

    string alumnos[n];
    double notas[n];

    cout << "Ingrese los nombres de los alumnos:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> alumnos[i];
    }

    cout << "Ingrese las notas de los alumnos:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> notas[i];
    }

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (notas[i] < notas[j]) {
                double tempNota = notas[i];
                notas[i] = notas[j];
                notas[j] = tempNota;

                string tempAlumno = alumnos[i];
                alumnos[i] = alumnos[j];
                alumnos[j] = tempAlumno;
            }
        }
    }

    cout << "Las tres mejores notas son:" << endl;
    for (int i = 0; i < 3 && i < n; i++) {
        cout << alumnos[i] << ": " << notas[i] << endl;
    }

    return 0;
}
