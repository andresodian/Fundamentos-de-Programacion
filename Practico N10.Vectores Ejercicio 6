#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    double vec[n];

    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    int m = n - 2;
    double prom[m];

    for (int i = 0; i < m; i++) {
        prom[i] = (vec[i] + vec[i+1] + vec[i+2]) / 3.0;
    }

    cout << "Promedios de cada tres valores consecutivos:" << endl;
    for (int i = 0; i < m; i++) {
        cout << prom[i] << " ";
    }
    cout << endl;

    return 0;
}
