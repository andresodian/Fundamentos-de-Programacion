#include <iostream>
#include <string>

using namespace std;

int main() {
    string texto;

    cout << "Ingrese un texto: ";
    getline(cin, texto);

    bool inicioPalabra = true;

    for (int i = 0; i < texto.length(); i++) {
        if (texto[i] == ' ') {
            inicioPalabra = true;
        } else {
            if (inicioPalabra && texto[i] >= 'a' && texto[i] <= 'z') {
                texto[i] = texto[i] - 32;
            }
            inicioPalabra = false;
        }
    }

    cout << texto << endl;

    return 0;
}
