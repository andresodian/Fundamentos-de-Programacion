#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    double vec[n];

    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    double suma = 0;
    for (int i = 0; i < n; i++) {
        suma += vec[i];
    }

    double promedio = suma / n;

    cout << "El promedio es: " << promedio << endl;

    return 0;
}
