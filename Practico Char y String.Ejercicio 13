#include <iostream>
#include <string>

using namespace std;

int BuscarSubCadena(string sub, string texto) {
    int lenSub = sub.length();
    int lenTexto = texto.length();

    for (int i = 0; i <= lenTexto - lenSub; i++) {
        bool encontrada = true;
        for (int j = 0; j < lenSub; j++) {
            if (texto[i + j] != sub[j]) {
                encontrada = false;
                break;
            }
        }
        if (encontrada) {
            return i + 1;
        }
    }
    return -1;
}

int main() {
    string texto, sub;
    
    cout << "Ingrese la cadena principal: ";
    cin >> texto;
    cout << "Ingrese la subcadena a buscar: ";
    cin >> sub;

    int posicion = BuscarSubCadena(sub, texto);

    cout << posicion << endl;

    return 0;
}
