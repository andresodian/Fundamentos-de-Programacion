#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    double vec[n];
    double rev[n];

    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    for (int i = 0; i < n; i++) {
        rev[i] = vec[n - 1 - i];
    }

    bool capicua = true;
    for (int i = 0; i < n; i++) {
        if (vec[i] != rev[i]) {
            capicua = false;
            break;
        }
    }

    if (capicua)
        cout << "El vector es capicua." << endl;
    else
        cout << "El vector no es capicua." << endl;

    return 0;
}
