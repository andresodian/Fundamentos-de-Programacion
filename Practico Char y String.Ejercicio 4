#include <iostream>
#include <string>

using namespace std;

int main() {
    string palabra, invertida = "";

    cout << "Ingrese una palabra: ";
    cin >> palabra;

    for (int i = palabra.length() - 1; i >= 0; i--) {
        invertida += palabra[i];
    }

    cout << invertida << endl;

    if (invertida == palabra) {
        cout << "Es capicua" << endl;
    } else {
        cout << "No es capicua" << endl;
    }

    return 0;
}
