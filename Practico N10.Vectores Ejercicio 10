#include <iostream>
using namespace std;

int main() {
    int n, m;
    cout << "Ingrese la cantidad de elementos del primer vector: ";
    cin >> n;
    cout << "Ingrese la cantidad de elementos del segundo vector: ";
    cin >> m;

    double A[n], B[m], C[n + m];

    cout << "Ingrese los valores del primer vector (ascendente):" << endl;
    for (int i = 0; i < n; i++) {
        cin >> A[i];
    }

    cout << "Ingrese los valores del segundo vector (ascendente):" << endl;
    for (int i = 0; i < m; i++) {
        cin >> B[i];
    }

    int i = 0, j = 0, k = 0;

    while (i < n && j < m) {
        if (A[i] <= B[j]) {
            C[k++] = A[i++];
        } else {
            C[k++] = B[j++];
        }
    }

    while (i < n) {
        C[k++] = A[i++];
    }

    while (j < m) {
        C[k++] = B[j++];
    }

    cout << "Vector intercalado y ordenado:" << endl;
    for (int t = 0; t < n + m; t++) {
        cout << C[t] << " ";
    }
    cout << endl;

    return 0;
}
