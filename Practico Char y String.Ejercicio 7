#include <iostream>
#include <string>

using namespace std;

int main() {
    string cadena;

    cout << "Ingrese una cadena: ";
    cin >> cadena;

    for (int i = 0; i < cadena.length() - 1; i++) {
        for (int j = 0; j < cadena.length() - 1; j++) {
            if (cadena[j] > cadena[j + 1]) {
                char aux = cadena[j];
                cadena[j] = cadena[j + 1];
                cadena[j + 1] = aux;
            }
        }
    }

    cout << cadena << endl;

    return 0;
}
