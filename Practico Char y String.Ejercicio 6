#include <iostream>
#include <string>

using namespace std;

int main() {
    string texto, sinVocales = "";
    string vocales = "aeiouAEIOU";

    cout << "Ingrese un texto: ";
    getline(cin, texto);

    for (int i = 0; i < texto.length(); i++) {
        bool esVocal = false;
        for (int j = 0; j < vocales.length(); j++) {
            if (texto[i] == vocales[j]) {
                esVocal = true;
                break;
            }
        }
        if (!esVocal) {
            sinVocales += texto[i];
        }
    }

    cout << sinVocales << endl;

    return 0;
}
