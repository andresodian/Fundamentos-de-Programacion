#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    double vec[n];

    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    double maxDiferencia = fabs(vec[1] - vec[0]);

    for (int i = 1; i < n - 1; i++) {
        double diff = fabs(vec[i+1] - vec[i]);
        if (diff > maxDiferencia) {
            maxDiferencia = diff;
        }
    }

    cout << "La diferencia mas grande entre elementos consecutivos es: " << maxDiferencia << endl;

    return 0;
}
