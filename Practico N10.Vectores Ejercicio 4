#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    double vec[n];
    double rev[n];

    cout << "Ingrese los valores:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }

    for (int i = 0; i < n; i++) {
        rev[i] = vec[n - 1 - i];
    }

    cout << "Vector invertido:" << endl;
    for (int i = 0; i < n; i++) {
        cout << rev[i] << " ";
    }
    cout << endl;

    return 0;
}
