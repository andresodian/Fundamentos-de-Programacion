#include <iostream>
#include <string>
using namespace std;

int main() {
    const int MAX = 100;
    string alumnos[MAX];
    double notas[MAX];
    int n = 0;
    int opcion;

    do {
        cout << "\nMenu de Alumnos:\n";
        cout << "1) Ingresar un alumno y su nota\n";
        cout << "2) Listar los alumnos\n";
        cout << "3) Ordenar alfabeticamente\n";
        cout << "4) Sacar la mejor nota\n";
        cout << "5) Sacar el promedio de notas\n";
        cout << "0) Salir\n";
        cout << "Ingrese una opcion: ";
        cin >> opcion;

        switch(opcion) {
            case 1: 
                if (n < MAX) {
                    cout << "Ingrese el nombre del alumno: ";
                    cin >> alumnos[n];
                    cout << "Ingrese la nota del alumno: ";
                    cin >> notas[n];
                    n++;
                } else {
                    cout << "Limite de alumnos alcanzado.\n";
                }
                break;

            case 2:
                cout << "Lista de alumnos:\n";
                for (int i = 0; i < n; i++) {
                    cout << alumnos[i] << ": " << notas[i] << endl;
                }
                break;

            case 3:
                for (int i = 0; i < n - 1; i++) {
                    for (int j = i + 1; j < n; j++) {
                        if (alumnos[i] > alumnos[j]) {
                            string tempAlumno = alumnos[i];
                            alumnos[i] = alumnos[j];
                            alumnos[j] = tempAlumno;

                            double tempNota = notas[i];
                            notas[i] = notas[j];
                            notas[j] = tempNota;
                        }
                    }
                }
                cout << "Alumnos ordenados alfabeticamente.\n";
                break;

            case 4:
                if (n > 0) {
                    double maxNota = notas[0];
                    string mejorAlumno = alumnos[0];
                    for (int i = 1; i < n; i++) {
                        if (notas[i] > maxNota) {
                            maxNota = notas[i];
                            mejorAlumno = alumnos[i];
                        }
                    }
                    cout << "Mejor nota: " << mejorAlumno << " con " << maxNota << endl;
                } else {
                    cout << "No hay alumnos registrados.\n";
                }
                break;

            case 5:
                if (n > 0) {
                    double suma = 0;
                    for (int i = 0; i < n; i++) {
                        suma += notas[i];
                    }
                    cout << "Promedio de notas: " << suma / n << endl;
                } else {
                    cout << "No hay alumnos registrados.\n";
                }
                break;

            case 0:
                cout << "Saliendo...\n";
                break;

            default:
                cout << "Opcion invalida.\n";
        }

    } while(opcion != 0);

    return 0;
}
