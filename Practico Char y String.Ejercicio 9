#include <iostream>
#include <string>

using namespace std;

int main() {
    string A, B, C = "";

    cout << "Ingrese conjunto A (sin espacios, ejemplo: kbcaIteqp): ";
    cin >> A;

    cout << "Ingrese conjunto B (sin espacios, ejemplo: amgpIhnk): ";
    cin >> B;

    for (int i = 0; i < A.length(); i++) {
        for (int j = 0; j < B.length(); j++) {
            if (A[i] == B[j]) {
                bool yaExiste = false;
                for (int k = 0; k < C.length(); k++) {
                    if (C[k] == A[i]) {
                        yaExiste = true;
                        break;
                    }
                }
                if (!yaExiste) {
                    C += A[i];
                }
            }
        }
    }

    cout << "C = " << C << endl;

    return 0;
}
