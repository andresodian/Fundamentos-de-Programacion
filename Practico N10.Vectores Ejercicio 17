#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la cantidad de numeros de Fibonacci: ";
    cin >> n;

    if (n <= 0) {
        cout << "La cantidad debe ser mayor a 0." << endl;
        return 0;
    }

    long long fib[n];
    fib[0] = 0;
    if (n > 1) fib[1] = 1;

    for (int i = 2; i < n; i++) {
        fib[i] = fib[i-1] + fib[i-2];
    }

    cout << "Los primeros " << n << " numeros de Fibonacci son:" << endl;
    for (int i = 0; i < n; i++) {
        cout << fib[i] << " ";
    }
    cout << endl;

    return 0;
}
