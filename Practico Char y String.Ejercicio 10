#include <iostream>
#include <string>

using namespace std;

int main() {
    string texto;
    string vocales = "aeiouAEIOU";
    int contador = 0;

    cout << "Ingrese un texto: ";
    getline(cin, texto);

    for (int i = 0; i < texto.length() - 1; i++) {
        bool primeraEsVocal = false, segundaEsVocal = false;

        for (int j = 0; j < vocales.length(); j++) {
            if (texto[i] == vocales[j]) primeraEsVocal = true;
            if (texto[i+1] == vocales[j]) segundaEsVocal = true;
        }

        if (primeraEsVocal && segundaEsVocal) {
            contador++;
            cout << texto[i] << texto[i+1] << " ";
            i++;
        }
    }

    cout << endl << contador << " vocales juntas" << endl;

    return 0;
}
